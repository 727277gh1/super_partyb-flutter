<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleDisplayName</key>
	<string>Spb Mobile</string>
	<!--
	  OIDC 授权回调（自定义 scheme）。

	  与 android/app/src/main/AndroidManifest.xml 的 <data android:scheme>
	  以及 lib/auth_deeplink.dart 的 OidcCallbackUri 常量必须一致。
	  iOS 侧没有 host/pathPrefix 的等价声明，只声明 scheme，具体 host/path
	  由 Dart 侧 OidcCallbackUri.matches() 校验。
	-->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.atjog.spb.oidc</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>partyb</string>
			</array>
		</dict>
		<!--
		  微信 OpenSDK 回跳 scheme（`wx<开放平台移动应用 AppID>`）——
		  **拿到 HostAppID 后必须补上，否则微信里点「返回App」不会有反应**。

		  为什么没直接写在这里：AppID 来自开放平台审核结果（issue #92 ① 账号侧），
		  仓库里无法预先知道；而 Flutter 的 dart-define 只注入 Dart 侧，
		  不会替换 Info.plist 里的变量。补法（Xcode 里操作等价）：

		  <dict>
		    <key>CFBundleTypeRole</key><string>Editor</string>
		    <key>CFBundleURLName</key><string>weixin</string>
		    <key>CFBundleURLSchemes</key>
		    <array><string>wx1234567890abcdef</string></array>
		  </dict>

		  漏了它的表现是**静默的**：小程序确认后 App 不会被拉回前台，
		  用户需要手动切回（轮询仍在跑，所以登录最终仍会完成，只是体验降级）。
		  由 `test/ios_platform_config_test.dart` 在注入了 `SPB_WECHAT_OPEN_APP_ID`
		  时提醒补全。
		-->
	</array>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>spb_mobile</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleSignature</key>
	<string>????</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!--
	  微信 OpenSDK（fluwx）要求的 scheme 白名单。

	  ## 为什么必须有

	  iOS 9+ 起 `canOpenURL:` 只对 Info.plist 里声明过的 scheme 返回 true。
	  漏声明的后果是 `fluwx.isWeChatInstalled` **恒为 false** —— 登录页因此
	  判定「微信未安装」并降级到 SSO，而用户手机上明明装着微信（issue #92）。

	  ## 四个值分别管什么

	  - `weixin`：微信主 App（安装检测、`WXApi` 回调）；
	  - `weixinULAPI`：微信 Universal Link 的跳转中转（iOS 13+ 必需，漏了会
	    「唤起成功但回不来」）；
	  - `weixinURLParamsAPI`：微信 SDK 内部用于带参跳转的私有 scheme；
	  - `wechat`：老版本微信的 scheme，仍有极少数设备在用。

	  这四个是微信官方 iOS 接入文档与 fluwx README 的同一份清单。
	-->
	<key>LSApplicationQueriesSchemes</key>
	<array>
		<string>weixin</string>
		<string>weixinULAPI</string>
		<string>weixinURLParamsAPI</string>
		<string>wechat</string>
	</array>
	<!--
	  本机门禁（issue #94）：`local_auth` 调 `LAContext.evaluatePolicy` 时必须
	  声明用途，缺失会让 Face ID 验证**直接失败**（系统拒绝），而错误信息
	  （`NSFaceIDUsageDescription` not found）只在 Xcode 控制台可见——表现为
	  「开关打开了但每次解锁都失败」，非常难查。

	  文案是那个系统弹窗上的一句话，要求写清「为什么」：这里说明验证通过后
	  只是解锁已登录的会话，不会重新登录、也不会上传生物特征（生物特征比对
	  全程在设备的安全隔区里，App 拿到的只有一个 bool）。
	-->
	<key>NSFaceIDUsageDescription</key>
	<string>用 Face ID 解锁已登录的会话，避免重复登录。生物特征不会被上传或存储。</string>
	<key>LSRequiresIPhoneOS</key>
	<true/>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key>
		<false/>
		<key>UISceneConfigurations</key>
		<dict>
			<key>UIWindowSceneSessionRoleApplication</key>
			<array>
				<dict>
					<key>UISceneClassName</key>
					<string>UIWindowScene</string>
					<key>UISceneConfigurationName</key>
					<string>flutter</string>
					<key>UISceneDelegateClassName</key>
					<string>$(PRODUCT_MODULE_NAME).SceneDelegate</string>
					<key>UISceneStoryboardFile</key>
					<string>Main</string>
				</dict>
			</array>
		</dict>
	</dict>
	<key>UIApplicationSupportsIndirectInputEvents</key>
	<true/>
	<key>UILaunchStoryboardName</key>
	<string>LaunchScreen</string>
	<key>UIMainStoryboardFile</key>
	<string>Main</string>
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UISupportedInterfaceOrientations~ipad</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationPortraitUpsideDown</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
</dict>
</plist>
