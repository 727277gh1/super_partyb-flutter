<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
      联网权限。

      ⚠️ 必须声明在 **main** 源集，不能只依赖 debug/profile 源集：
      `src/debug/AndroidManifest.xml` 与 `src/profile/AndroidManifest.xml` 里
      各有一份 INTERNET，但那只用于 Flutter 工具的热重载/断点通信，**release
      构建不会合并它们**。

      也不能指望插件贡献：已逐个核对全部依赖的 `android/src/main/
      AndroidManifest.xml`，贡献 INTERNET 的插件数为 **0**（flutter_secure_
      storage / app_links / file_selector_android / sqlite3_flutter_libs 等
      都没有）。

      缺失时的表现是「debug 能跑、release 包一联网就失败」——而且不是崩
      溃，是 API 调用抛 SocketException / 登录无响应，排查成本高。
    -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <application
        android:label="spb_mobile"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
            </intent-filter>
            <!--
              OIDC 授权回调（自定义 scheme）。

              ⚠️ 与 `packages/spb_api/lib/src/oidc_callback.dart` 的 OidcCallbackUri
              常量必须一致：scheme=partyb, host=oidc, pathPrefix=/callback。
              两处（此处、Dart 常量）不一致会表现为「登录后应用毫无反应」而不是报错。

              已由 IdP 注册（oauth_clients.redirectUris 含 partyb://oidc/callback），
              实测 authorize 可正常 302 回跳，见 docs/mobile-oidc-deeplink.md。
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="partyb" android:host="oidc" android:pathPrefix="/callback"/>
            </intent-filter>
            <!--
              OIDC 授权回调（claimed HTTPS / Android App Links）。

              ## 为什么需要这一条

              自定义 scheme 没有归属校验：任何声明了 partyb scheme 的应用都能抢走回调。
              autoVerify 让系统去取 `https://<host>/.well-known/assetlinks.json`，
              校验通过后**只有本应用**能接管该域名的这个路径（RFC 8252 §7.2 首选）。

              ## 三个必须同时成立的条件

              1. 服务端返回 assetlinks.json（api-gateway 的 verification_files，
                 package_name + 签名指纹 + application/json）；
              2. 本 intent-filter 的 scheme/host/path 与之完全一致；
              3. 安装的是**指纹匹配**的那个 APK（换签名密钥后须同步更新服务端）。

              任一不成立都是**静默**失败：链接照常打开浏览器，无任何报错。
              排查：adb shell pm get-app-links com.atjog.spb.spb_mobile

              ## 为什么两个 host 都写

              双栈：tbcc 走 CDN（IPv4/IPv6 均可）、tbcc6 是源站别名。
              OIDC issuer 用哪个域名，回调就从哪个域名回来，两个都要能接管。
              path 与 Dart 侧 OidcCallbackUri.claimedHttpsPath 保持一致（/idp 前缀 + /app/callback）。
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW"/>
                <category android:name="android.intent.category.DEFAULT"/>
                <category android:name="android.intent.category.BROWSABLE"/>
                <data android:scheme="https" android:host="tbcc.atjog.com" android:path="/idp/app/callback"/>
                <data android:scheme="https" android:host="tbcc6.atjog.com" android:path="/idp/app/callback"/>
            </intent-filter>
        </activity>
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
    </queries>
</manifest>
