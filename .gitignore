# ---- Dart / Flutter ----
.dart_tool/
.packages
build/
*.iml
.flutter-plugins
.flutter-plugins-dependencies

# 生成物（build_runner 产出）
#
# ⚠️ 例外必须写成 `!**/lib/**/*.g.dart`（带 `**/` 前缀）。
# gitignore 的模式若含斜杠则相对 .gitignore 所在目录锚定，
# `!lib/**/*.g.dart` 只能匹配**根目录**下的 lib/，对
# `packages/spb_data/lib/src/database.g.dart` 这种嵌套路径无效——
# 而本仓库是 melos 工作区，所有包都在 packages/*/lib/ 下。
*.g.dart
*.freezed.dart
!**/lib/**/*.g.dart

# 依赖
pubspec.lock

# ---- IDE ----
.idea/
.vscode/
*.swp
*.swo

# ---- 平台构建产物 ----
apps/*/android/.gradle/
apps/*/android/local.properties
apps/*/android/app/debug/
apps/*/android/app/profile/
apps/*/android/app/release/
apps/*/ios/Pods/
apps/*/ios/.symlinks/
apps/*/ios/Flutter/Flutter.framework
apps/*/ios/Flutter/Flutter.podspec
apps/*/linux/flutter/ephemeral/
apps/*/macos/Flutter/ephemeral/
apps/*/windows/flutter/ephemeral/

# ---- 签名与密钥（绝不提交）----
*.jks
*.keystore
key.properties
*.p12
*.mobileprovision
*.pfx

# ---- 本地配置 ----
.env
.env.*
!.env.example

# ---- 其他 ----
.DS_Store
*.log

# ---- AI Agent 本地状态 ----
# pi harness 的目标追踪文件（objective / journal / task cursor），
# 属本机会话状态而非项目源码，不入库。
.pi/
